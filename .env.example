# Run commands from the repository root. Copy this file to .env.
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/trendforge.db
# Required when DEMO_MODE=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
ALPHA_VANTAGE_API_KEY=
FINANCE_SYMBOLS=IBM
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_IDS=
GITHUB_TOKEN=
GITHUB_REPOS=
# No built-in generally available Google Trends integration; this flag alone grants no access.
GOOGLE_TRENDS_ENABLED=false
# Comma-separated entry-point names from explicitly installed, trusted provider packages.
PROVIDER_PLUGINS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
REPORTS_DIR=reports
REQUEST_LIMIT_PER_MINUTE=180
